#!/usr/bin/env python3
# JP-117: link a graph step's session to its run when its first prompt carries the runner's marker. Acts only on
# sessions the runner started. See graphs/runner/runner_lib/hooklib.py.
import sys
sys.dont_write_bytecode = True
from pathlib import Path

try:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "graphs" / "runner"))
    from runner_lib import hooklib
    code = hooklib.main("UserPromptSubmit")
except Exception:
    code = 0
sys.exit(0 if code is None else code)
