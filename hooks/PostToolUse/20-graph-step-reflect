#!/usr/bin/env python3
# JP-117: every 40 tool calls, ask a graph step's session whether it is looping. Acts only on sessions the runner
# started; never blocks. See graphs/runner/runner_lib/hooklib.py.
import sys
sys.dont_write_bytecode = True
from pathlib import Path

try:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "graphs" / "runner"))
    from runner_lib import hooklib
    code = hooklib.main("PostToolUse")
except Exception:
    code = 0
sys.exit(0 if code is None else code)
