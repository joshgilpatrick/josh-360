#!/usr/bin/env python3
# JP-118: tell this session about new comments on its ticket. Reads only its own inbox folder; never opens the
# ledger, never blocks (always exits 0). See ledger/comments.py.
import sys
sys.dont_write_bytecode = True
from pathlib import Path

try:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    from ledger import comments
    code = comments.hook_main("PostToolUse", sys.stdin, sys.stdout)
except Exception:
    code = 0
sys.exit(0 if code is None else code)
