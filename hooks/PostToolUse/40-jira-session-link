#!/bin/bash
# JP-111: records a cost-ledger link when a successful Jira transition or comment names an issue key
# (apps/session-atlas/src/costledger/jira-hook-cli.ts, which writes cache.db). Cheap prefilter: node only starts when the
# command mentions Jira. Does nothing until the retire-session-atlas job has succeeded, so it cannot create an empty
# cache.db before the old cost history is seeded into it. Always exits 0 so it can never block or fail a Bash call.
# Prints nothing.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cli="${here}/../../apps/session-atlas/src/costledger/jira-hook-cli.ts"
input="$(cat)"
case "$input" in
  *"jira workitem"*)
    state="${JOSH360_HOME:-$HOME/.josh-360}/state/jobs-state.json"
    python3 -c 'import json,sys; sys.exit(0 if json.load(open(sys.argv[1])).get("retire-session-atlas", {}).get("last_result") == 0 else 1)' "$state" 2>/dev/null || exit 0
    node_bin="$(command -v node 2>/dev/null)"
    [ -n "$node_bin" ] && [ -f "$cli" ] && printf '%s' "$input" | "$node_bin" --disable-warning=ExperimentalWarning "$cli" >/dev/null 2>&1
    ;;
esac
exit 0
