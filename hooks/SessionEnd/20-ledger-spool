#!/usr/bin/env python3
# JP-107: append one line to the ledger spool for this event. Never opens the ledger; always exits 0.
import sys
sys.dont_write_bytecode = True
from pathlib import Path

try:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    from ledger import spool
    code = spool.main("SessionEnd", sys.stdin)
except Exception:
    code = 0
sys.exit(0 if code is None else code)
