 },
 "compiled": 1,
 "graph": {
  "convention": 1,
  "description": "Takes a Ready non-development ticket in JP (an answer, a document, a reply to draft, a file to find) and ends with its deliverable saved outside any working folder, the sources behind it in an evidence file, Josh's sign-off (or, for an emailed ask, the answer emailed to him, reopened only by his reply), and a resolution comment that the next run's lookup can find. Nothing is sent to anyone but Josh, and a shared write runs only on his yes.\n",
  "graph": "non-development",
  "header": {
   "access": {
    "check_deliverable": "read",
    "check_gaps": "read",
    "check_review": "josh",
    "close": "josh",
    "close_emailed": "josh",
    "decide_stuck": "read",
    "deliver": "josh",
    "do_work": "josh",
    "find_precedent": "read",
    "judge_precedent": "read",
    "pick_path": "read",
    "pick_sign_off": "read",
    "ping_before": "read",
    "ping_during": "read",
    "read_ticket": "read",
    "return_early": "josh",
    "return_late": "josh",
    "review_work": "read",
    "share_out": "shared",
    "sign_off": "read",
    "start_run": "josh",
    "to_validation": "josh"
   },
   "asks_josh": [
    "ping_before",
    "ping_during",
    "sign_off",
    "decide_stuck"
   ],
   "end_states": {
    "close_emailed.closed": "success",
    "decide_stuck.stop": "needs-josh",
    "finished": "success",
    "return_early.returned": "neutral",
    "return_late.returned": "neutral"
   },
   "entry_gate": "ready",
   "exit_gate": "no-loose-ends",
   "jira": [
    {
     "status": "Ready",
     "steps": [
      "read_ticket"
     ]
    },
    {
     "status": "Not Started",
     "steps": [
      "return_early",
      "return_late"
     ]
    },
    {
     "status": "In Progress",
     "steps": [
      "start_run",
      "find_precedent",
      "judge_precedent",
      "check_gaps",
      "ping_before",
      "do_work",
      "ping_during",
      "check_deliverable",
      "pick_path",
      "review_work",
      "check_review",
      "decide_stuck"
     ]
    },
    {
     "status": "Validation",
     "steps": [
      "to_validation",
      "deliver",
      "pick_sign_off",
      "sign_off",
      "share_out"
     ]
    },
    {
     "status": "Done",
     "steps": [
      "close_emailed",
      "close"
     ]
    }
   ],
   "ledger": [
    "run",
    "step",
    "outcome",
    "loop_count",
    "session",
    "tier",
    "ticket",
    "started_at",
    "ended_at",
    "graph_version",
    "model"
   ]
  },
  "inputs": {
   "desk_row": {
    "default": "none",
    "description": "The desk ledger row of the email thread, when origin is email",
    "type": "string"
   },
   "kind": {
    "default": "research",
    "description": "The work kind from the ticket's action-triage.spec property (research, doc, email, meeting, misc); research when the ticket has none. Picks the agent.\n",
    "type": "string"
   },
   "origin": {
    "default": "ticket",
    "description": "email when the ticket came through the Email Research Desk, else ticket",
    "type": "string"
   },
   "phi": {
    "default": true,
    "description": "The ticket's phi_risk; true when the ticket does not say",
    "type": "boolean"
   },
   "system": {
    "default": "none",
    "description": "The registry system triage recorded, or none",
    "type": "string"
   },
   "ticket_key": {
    "description": "The JP ticket, for example JP-140",
    "required": true,
    "type": "string"
   }
  },
  "outputs": {
   "deliverable_path": {
    "description": "Where the deliverable is saved, outside any working folder",
    "type": "string"
   },
   "evidence_path": {
    "description": "The evidence file beside it",
    "type": "string"
   }
  },
  "steps": [
   {
    "gate": "read-ticket",
    "id": "read_ticket",
    "inputs": [
     "ticket_key",
     "kind",
     "system",
     "phi"
    ],
    "outcomes": [
     "workable",
     "not_here"
    ],
    "outputs": {
     "deliverable_given": {
      "description": "True when the Deliverable format came from Josh, not inferred",
      "type": "boolean"
     },
     "reason": {
      "description": "Why the ticket cannot be worked here, in a fixed sentence, when the outcome is not_here",
      "type": "string"
     },
     "search_terms": {
      "description": "Words and synonyms for the lookup, from the ticket",
      "type": "list"
     }
    }
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "return-to-triage",
    "id": "return_early",
    "inputs": [
     "ticket_key",
     "reason"
    ],
    "needs": [
     "read_ticket"
    ],
    "on": {
     "returned": "end"
    },
    "outcomes": [
     "returned"
    ],
    "when": {
     "outcome": "not_here",
     "step": "read_ticket"
    }
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "move-ticket",
    "id": "start_run",
    "inputs": [
     "ticket_key"
    ],
    "needs": [
     "return_early"
    ],
    "outcomes": [
     "moved"
    ],
    "when": {
     "outcome": "workable",
     "step": "read_ticket"
    }
   },
   {
    "brief": "Search JP for tickets that already answered the question on {{ inputs.ticket_key }}. A match is a ticket asking the same question; list closed ones with a Resolution comment first, then open ones.",
    "id": "find_precedent",
    "inputs": [
     "ticket_key",
     "search_terms"
    ],
    "needs": [
     "start_run"
    ],
    "outcomes": [
     "found",
     "none"
    ],
    "outputs": {
     "candidates": {
      "description": "The role's JSON list of {key, summary, status, is_match, why}, best first",
      "type": "list"
     }
    },
    "role": "jira-searcher"
   },
   {
    "id": "judge_precedent",
    "inputs": [
     "ticket_key",
     "candidates"
    ],
    "needs": [
     "find_precedent"
    ],
    "outcomes": [
     "answers",
     "related_only"
    ],
    "outputs": {
     "precedent": {
      "description": "The one ticket whose resolution answers this one, or none",
      "type": "string"
     }
    },
    "role": "precedent-judge",
    "when": {
     "outcome": "found",
     "step": "find_precedent"
    }
   },
   {
    "gate": "gap-check",
    "id": "check_gaps",
    "inputs": [
     "ticket_key",
     "kind",
     "deliverable_given",
     "precedent"
    ],
    "needs": [
     "judge_precedent"
    ],
    "outcomes": [
     "clear",
     "gap"
    ],
    "outputs": {
     "card": {
      "description": "The same sentence, shown to Josh on the ask below",
      "type": "string"
     },
     "gap": {
      "description": "The one thing to ask, in one sentence, when the outcome is gap",
      "type": "string"
     }
    }
   },
   {
    "ask": {
     "choices": [
      "answered"
     ],
     "question": "Before I start {{ inputs.ticket_key }}: is the deliverable I assumed the right one? (One sentence is enough.)"
    },
    "id": "ping_before",
    "needs": [
     "check_gaps"
    ],
    "when": {
     "outcome": "gap",
     "step": "check_gaps"
    }
   },
   {
    "agent": {
     "by": "kind",
     "default": "answerer",
     "map": {
      "doc": "drafter",
      "email": "drafter",
      "misc": "finder",
      "research": "answerer"
     }
    },
    "brief": "Ticket {{ inputs.ticket_key }}, system {{ inputs.system }}. Read the ticket and its comments, including any answer from Josh.",
    "id": "do_work",
    "inputs": [
     "ticket_key",
     "system",
     "phi",
     "precedent"
    ],
    "needs": [
     "ping_before"
    ],
    "outcomes": [
     "done",
     "blocked",
     "needs_code"
    ],
    "outputs": {
     "deliverable_path": {
      "description": "The deliverable, saved in Josh's artifacts folder",
      "type": "string"
     },
     "evidence_path": {
      "contract": "evidence",
      "type": "string"
     }
    },
    "role": "researcher"
   },
   {
    "ask": {
     "choices": [
      "answered"
     ],
     "question": "{{ inputs.ticket_key }} is stuck on one missing fact, named in the ticket's last comment. What is it?"
    },
    "id": "ping_during",
    "needs": [
     "do_work"
    ],
    "on": {
     "answered": {
      "at_limit": "decide_stuck",
      "goto": "do_work",
      "max_loops": 2
     }
    },
    "when": {
     "outcome": "blocked",
     "step": "do_work"
    }
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "return-to-triage",
    "id": "return_late",
    "inputs": [
     "ticket_key"
    ],
    "needs": [
     "do_work"
    ],
    "on": {
     "returned": "end"
    },
    "outcomes": [
     "returned"
    ],
    "when": {
     "outcome": "needs_code",
     "step": "do_work"
    }
   },
   {
    "gate": "check-deliverable",
    "id": "check_deliverable",
    "inputs": [
     "ticket_key",
     "phi",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "ping_during",
     "return_late"
    ],
    "on": {
     "incomplete": {
      "at_limit": "decide_stuck",
      "goto": "do_work",
      "max_loops": 2
     }
    },
    "outcomes": [
     "complete",
     "incomplete"
    ],
    "when": {
     "outcome": "done",
     "step": "do_work"
    }
   },
   {
    "gate": "pick-path",
    "id": "pick_path",
    "inputs": [
     "ticket_key",
     "kind",
     "precedent",
     "evidence_path"
    ],
    "needs": [
     "check_deliverable"
    ],
    "outcomes": [
     "short",
     "full"
    ]
   },
   {
    "id": "review_work",
    "inputs": [
     "ticket_key",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "pick_path"
    ],
    "outcomes": [
     "pass",
     "defects"
    ],
    "outputs": {
     "findings": {
      "contract": "feedback",
      "description": "Defects, each quoting the ticket's Question or Deliverable format",
      "type": "list"
     }
    },
    "role": "work-checker",
    "when": {
     "outcome": "full",
     "step": "pick_path"
    }
   },
   {
    "gate": "check-review",
    "id": "check_review",
    "inputs": [
     "ticket_key",
     "findings",
     "evidence_path"
    ],
    "needs": [
     "review_work"
    ],
    "on": {
     "rework": {
      "at_limit": "decide_stuck",
      "goto": "do_work",
      "max_loops": 2
     }
    },
    "outcomes": [
     "clean",
     "rework"
    ],
    "when": {
     "outcome": "full",
     "step": "pick_path"
    }
   },
   {
    "ask": {
     "choices": [
      "retry",
      "stop"
     ],
     "on_limit_only": true,
     "question": "{{ inputs.ticket_key }} has used its work runs (three per run) without a usable deliverable. Allow one more run, or stop and leave it with me?"
    },
    "id": "decide_stuck",
    "on": {
     "retry": {
      "at_limit": "decide_stuck",
      "goto": "do_work",
      "max_loops": 1
     },
     "stop": "end"
    }
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "move-ticket",
    "id": "to_validation",
    "inputs": [
     "ticket_key"
    ],
    "needs": [
     "check_review"
    ],
    "outcomes": [
     "moved"
    ]
   },
   {
    "gate": "deliver",
    "id": "deliver",
    "inputs": [
     "ticket_key",
     "origin",
     "desk_row",
     "phi",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "to_validation"
    ],
    "outcomes": [
     "delivered"
    ],
    "outputs": {
     "card": {
      "description": "The ticket comment, shown to Josh on his sign-off ask",
      "type": "string"
     }
    }
   },
   {
    "gate": "sign-off-rule",
    "id": "pick_sign_off",
    "inputs": [
     "origin"
    ],
    "needs": [
     "deliver"
    ],
    "outcomes": [
     "ask_josh",
     "emailed"
    ]
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "close-ticket",
    "id": "close_emailed",
    "inputs": [
     "ticket_key",
     "phi",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "pick_sign_off"
    ],
    "on": {
     "closed": "end"
    },
    "outcomes": [
     "closed"
    ],
    "when": {
     "outcome": "emailed",
     "step": "pick_sign_off"
    }
   },
   {
    "ask": {
     "approves": [
      "share_out"
     ],
     "approves_on": [
      "accept_and_share"
     ],
     "choices": [
      "accept",
      "accept_and_share",
      "revise"
     ],
     "question": "The deliverable for {{ inputs.ticket_key }} is ready (path and summary in the ticket). Sign it off?"
    },
    "id": "sign_off",
    "needs": [
     "close_emailed"
    ],
    "on": {
     "revise": {
      "at_limit": "decide_stuck",
      "goto": "do_work",
      "max_loops": 2
     }
    }
   },
   {
    "gate": "share",
    "id": "share_out",
    "inputs": [
     "ticket_key",
     "phi",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "sign_off"
    ],
    "outcomes": [
     "shared",
     "refused"
    ],
    "when": {
     "outcome": "accept_and_share",
     "step": "sign_off"
    }
   },
   {
    "effects": [
     "move_ticket"
    ],
    "gate": "close-ticket",
    "id": "close",
    "inputs": [
     "ticket_key",
     "phi",
     "deliverable_path",
     "evidence_path"
    ],
    "needs": [
     "share_out"
    ],
    "outcomes": [
     "closed"
    ]
   }
  ],
  "title": "Non-development pipeline"
 },
