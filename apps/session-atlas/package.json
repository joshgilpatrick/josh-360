{
  "name": "josh-360-session-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "artifacts": "node --disable-warning=ExperimentalWarning src/cli/artifacts.ts",
    "costledger": "node --disable-warning=ExperimentalWarning src/costledger/cli.ts",
    "start": "node --disable-warning=ExperimentalWarning src/service/main.ts",
    "backfill": "node --disable-warning=ExperimentalWarning src/transcript/backfill.ts",
    "recompute-projects": "node --disable-warning=ExperimentalWarning src/transcript/backfill.ts --projects",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-benchmark.ts",
    "perf": "ATLAS_PERF=1 node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/perf/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
